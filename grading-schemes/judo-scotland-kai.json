{
  "name": {
    "en": "Kai grades (Scotland)"
  },
  "organisation": "JudoScotland",
  "country": "GB",
  "order": 1,
  "description": {
    "en": "JudoScotland's Kai pathway: nine gradings for children aged 5 to 7, marked on one belt by a coloured stripe. At 8 a Kai holder transfers into the Mon system."
  },
  "beltMark": "stripe",
  "beltNote": {
    "en": "Kai is not regulated centrally. Your club's colours may differ."
  },
  "source": {
    "title": "JudoScotland Kai Grade Syllabus (1st to 3rd, 4th to 6th, 7th to 9th Kai)",
    "note": {
      "en": "Item wording is exactly as printed on the three syllabus sheets, which name techniques only from 7th Kai: everything below that is \"coaches choice\", deliberately, because a coach picks what suits a five-year-old. The techniques listed for each grade are therefore those the sheet names plus the Mon syllabus the owner's equivalence chart pairs the grade with (1st to 3rd Kai with 2nd Mon, 4th to 6th with 3rd Mon, 7th to 9th with 4th Mon), which is the pool a coach chooses from. The sheets carry no column headings; the three section titles here describe the sheet's own three columns."
    }
  },
  "posters": [
    {
      "id": "poster-1st-3rd-kai",
      "alt": {
        "en": "JudoScotland syllabus sheet for 1st to 3rd Kai: back, forward and side breakfalls from crouching, jumping and hopping with a partner, a throw and a hold of the coach's choice, bowing, and the meaning of matte, hajime, dojo and judogi."
      },
      "provenance": "third-party",
      "credit": "JudoScotland",
      "source": "JudoScotland Kai Grade Syllabus 1st To 3rd Kai"
    },
    {
      "id": "poster-4th-6th-kai",
      "alt": {
        "en": "JudoScotland syllabus sheet for 4th to 6th Kai: front breakfall from knees, forward roll, side and back breakfalls from standing, two throws and two holds of the coach's choice, tying the belt, submitting, and the meaning of ukemi, ippon, soremade, waza ari, sonomama and yoshi."
      },
      "provenance": "third-party",
      "credit": "JudoScotland",
      "source": "JudoScotland Kai Grade Syllabus 4th to 6th Kai"
    },
    {
      "id": "poster-7th-9th-kai",
      "alt": {
        "en": "JudoScotland syllabus sheet for 7th to 9th Kai: backward and forward rolls, two throws and two holds of the coach's choice with Osoto-otoshi, De-ashi-barai, Kesa-gatame and Mune-gatame named, taking a grip, a minute of randori and of newaza, and the referee signs for matte, ippon and waza ari."
      },
      "provenance": "third-party",
      "credit": "JudoScotland",
      "source": "JudoScotland Kai Grade Syllabus 7th to 9th Kai"
    }
  ],
