{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "note": {
      "allOf": [
        {
          "$ref": "#/definitions/localisedText"
        }
      ]
    }
  },
  "required": [
    "name",
    "url"
  ],
  "definitions": {
    "localisedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by BCP 47 language code; \"en\" required, other languages optional."
    }
  },
  "title": "channel",
  "description": "One YouTube channel worth following. Not a provider: nothing on a channel is indexed technique by technique, so a channel is never ranked."
}
