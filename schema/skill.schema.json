{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "#/definitions/localisedText"
    },
    "nameRomaji": {
      "type": "string",
      "minLength": 1
    },
    "nameJa": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "ukemi",
        "movement",
        "kumi-kata",
        "escape",
        "turnover"
      ]
    },
    "techniques": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "about": {
      "$ref": "#/definitions/localisedText"
    },
    "keyPoints": {
      "$ref": "#/definitions/localisedKeyPoints"
    },
    "described": {
      "$ref": "#/definitions/localisedSteps"
    },
    "receiving": {
      "allOf": [
        {
          "$ref": "#/definitions/localisedText"
        }
      ]
    },
    "viNotes": {
      "allOf": [
        {
          "$ref": "#/definitions/localisedText"
        }
      ]
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/video"
      }
    },
    "image": {
      "allOf": [
        {
          "$ref": "#/definitions/imageRef"
        }
      ]
    }
  },
  "required": [
    "name",
    "kind",
    "about",
    "keyPoints",
    "described",
    "videos"
  ],
  "definitions": {
    "localisedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by BCP 47 language code; \"en\" required, other languages optional."
    },
    "localisedKeyPoints": {
      "type": "object",
      "properties": {
        "en": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "minItems": 3,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Exactly three key points per language; \"en\" required."
    },
    "localisedSteps": {
      "type": "object",
      "properties": {
        "en": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Ordered movement steps per language (at least two); \"en\" required."
    },
    "video": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube",
            "vimeo"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "allOf": [
            {
              "$ref": "#/definitions/localisedText"
            }
          ]
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "default": false,
          "type": "boolean"
        },
        "lang": {
          "type": "string"
        },
        "captions": {
          "type": "boolean"
        },
        "spokenInstruction": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "platform",
        "id",
        "title"
      ]
    },
    "imageRef": {
      "type": "object",
      "properties": {
        "alt": {
          "$ref": "#/definitions/localisedText"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "own",
            "licensed",
            "third-party",
            "unknown"
          ]
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "alt",
        "provenance"
      ]
    }
  },
  "title": "skill",
  "description": "One examined skill that is not a technique: a breakfall, a gripping skill, an escape from a hold, or a turnover."
}
