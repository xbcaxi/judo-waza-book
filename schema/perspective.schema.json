{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "source": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "pathway": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "evidenceLabel": {
          "type": "string",
          "minLength": 1
        },
        "translationStatus": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "jurisdiction",
        "pathway",
        "population",
        "evidenceLabel"
      ]
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "examining",
              "coaching",
              "safety",
              "terminology",
              "context"
            ]
          },
          "heading": {
            "allOf": [
              {
                "$ref": "#/definitions/localisedText"
              }
            ]
          },
          "prose": {
            "allOf": [
              {
                "$ref": "#/definitions/localisedText"
              }
            ]
          },
          "steps": {
            "allOf": [
              {
                "$ref": "#/definitions/localisedSteps"
              }
            ]
          },
          "pages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/definitions/sourcePageRef"
            }
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    "sourcePages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string",
            "minLength": 1
          },
          "printedPage": {
            "type": "string",
            "minLength": 1
          },
          "jaSource": {
            "type": "string",
            "enum": [
              "pdf_text",
              "ocr",
              "none"
            ]
          },
          "nameInSource": {
            "type": "string",
            "minLength": 1
          },
          "textJa": {
            "type": "string"
          },
          "figureTextConfidence": {
            "type": "string",
            "enum": [
              "normal",
              "medium",
              "low"
            ]
          }
        },
        "required": [
          "recordId",
          "printedPage"
        ]
      }
    },
    "videos": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/video"
      }
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/linkRef"
      }
    }
  },
  "required": [
    "sections"
  ],
  "definitions": {
    "localisedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by BCP 47 language code; \"en\" required, other languages optional."
    },
    "localisedSteps": {
      "type": "object",
      "properties": {
        "en": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Ordered movement steps per language (at least two); \"en\" required."
    },
    "sourcePageRef": {
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "printedPage": {
          "type": "string",
          "minLength": 1
        },
        "jaSource": {
          "type": "string",
          "enum": [
            "pdf_text",
            "ocr",
            "none"
          ]
        }
      },
      "required": [
        "recordId",
        "printedPage"
      ]
    },
    "video": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube",
            "vimeo"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "allOf": [
            {
              "$ref": "#/definitions/localisedText"
            }
          ]
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "default": false,
          "type": "boolean"
        },
        "lang": {
          "type": "string"
        },
        "captions": {
          "type": "boolean"
        },
        "spokenInstruction": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "platform",
        "id",
        "title"
      ]
    },
    "linkRef": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "url",
        "source"
      ]
    }
  },
  "title": "perspective",
  "description": "One organisation's voice on one technique or one examination, layered over the record for readers who opt into that organisation's view. Filed by what it speaks about: perspectives/<organisation>/techniques/<slug>.json. A perspective ADDS context and never forks the record. Where it was transcribed from a published document it carries `source`, because the same sentence means different things depending on the population the document was written for."
}
