{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "national-body",
        "affiliate",
        "club",
        "government"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "about": {
      "allOf": [
        {
          "$ref": "#/definitions/localisedText"
        }
      ]
    },
    "schemes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exams": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "name",
    "kind",
    "country"
  ],
  "definitions": {
    "localisedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by BCP 47 language code; \"en\" required, other languages optional."
    }
  },
  "title": "organisation",
  "description": "One body that speaks about judo: a federation, an affiliate under one, a club, or a government ministry that decides what schools teach. The organisation id is the filename."
}
