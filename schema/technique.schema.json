{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameRomaji": {
      "type": "string",
      "minLength": 1
    },
    "nameJa": {
      "type": "string",
      "minLength": 1
    },
    "nameKana": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "The Japanese name in hiragana, which is how it is pronounced. Null where it has not been written yet."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alternative romanisations of the same name. Empty when there are none."
    },
    "otherNames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "system": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "note": {
            "allOf": [
              {
                "$ref": "#/definitions/localisedText"
              }
            ]
          }
        },
        "required": [
          "name",
          "system"
        ]
      },
      "description": "The same technique's name in other systems. Empty when there are none."
    },
    "gloss": {
      "$ref": "#/definitions/localisedText"
    },
    "category": {
      "type": "string",
      "enum": [
        "nage-waza",
        "katame-waza",
        "atemi-waza"
      ],
      "description": "The Kodokan group the technique belongs to: nage-waza (throwing), katame-waza (grappling) or atemi-waza (striking)."
    },
    "subCategory": {
      "type": "string",
      "enum": [
        "tachi-waza",
        "sutemi-waza",
        "osaekomi-waza",
        "shime-waza",
        "kansetsu-waza",
        "ude-ate",
        "ashi-ate"
      ],
      "description": "The division within the group: tachi-waza or sutemi-waza for a throw; osaekomi-waza, shime-waza or kansetsu-waza for a grappling technique; ude-ate or ashi-ate for a strike."
    },
    "wazaType": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "te-waza",
            "koshi-waza",
            "ashi-waza",
            "ma-sutemi-waza",
            "yoko-sutemi-waza"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "How a throw takes uke down. Null on everything that is not a throw, where the classification has no third level."
    },
    "gokyoSet": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ],
      "description": "Which set of the Gokyo no Waza the throw belongs to. Null for a throw outside the Gokyo and for everything that is not a throw."
    },
    "kodokanNumber": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 101,
          "maximum": 810
        },
        {
          "type": "null"
        }
      ],
      "description": "The technique's number in the Kodokan classification, 101 to 810. Null for a technique outside the hundred the Kodokan recognises."
    },
    "kodokanAbbr": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "The three-letter abbreviation the IJF and Kodokan use for the technique. Null for a technique outside the hundred."
    },
    "kodokan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "nameRomaji": {
              "type": "string",
              "minLength": 1
            },
            "nameJa": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "nameRomaji",
            "nameJa"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The Kodokan's own romaji and kanji for the technique, from its published definitions, where they differ from the name this book leads with. Null where they agree."
    },
    "banned": {
      "type": "string",
      "enum": [
        "no",
        "in-competition",
        "yes"
      ],
      "description": "Whether the technique is prohibited. \"no\" where it is not; \"in-competition\" where contest rules bar it but it is still taught, demonstrated and examined; \"yes\" where it is not to be applied at all and is documented for recognition only."
    },
    "bannedNote": {
      "anyOf": [
        {
          "$ref": "#/definitions/localisedText"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the prohibition is and why. Required whenever banned is not \"no\", null otherwise."
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/video"
      },
      "description": "Demonstrations, in no particular order. Empty when none has been found yet."
    },
    "ijfAnimation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "The technique's name in the IJF's own spelling, where the IJF publishes an animation of it. Null where there is none."
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/linkRef"
      },
      "description": "Reference pages worth reading. Empty when none has been found yet."
    },
    "image": {
      "anyOf": [
        {
          "$ref": "#/definitions/imageRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Illustration metadata. Null where the technique has no illustration yet."
    },
    "about": {
      "$ref": "#/definitions/localisedText"
    },
    "keyPoints": {
      "$ref": "#/definitions/localisedKeyPoints"
    },
    "described": {
      "anyOf": [
        {
          "$ref": "#/definitions/localisedSteps"
        },
        {
          "type": "null"
        }
      ],
      "description": "The whole movement narrated for the ear. Null where nobody has written it yet - and on banned techniques, which carry no step-by-step by policy."
    },
    "receiving": {
      "anyOf": [
        {
          "$ref": "#/definitions/localisedText"
        },
        {
          "type": "null"
        }
      ],
      "description": "What the throw feels like to uke and how to land it. Null where nobody has written it yet."
    },
    "viNotes": {
      "anyOf": [
        {
          "$ref": "#/definitions/localisedText"
        },
        {
          "type": "null"
        }
      ],
      "description": "Notes for visually impaired judoka and their coaches. Null where nobody has written them yet."
    },
    "resolver": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "counter": {
              "type": "boolean",
              "description": "True when the technique answers the opponent's own attack, so the person thrown is the one who attacked first."
            },
            "fall": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "forwards",
                    "backwards",
                    "sideways",
                    "down"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Which way the thrown judoka falls. Null on katame-waza."
            },
            "mechanism": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "hip-lift",
                    "shoulder-carry",
                    "leg-lift",
                    "leg-reap",
                    "heel-clip",
                    "leg-block",
                    "leg-scissor",
                    "hands-only",
                    "leg-grab",
                    "wrap-roll",
                    "foot-in-belly",
                    "pull-over",
                    "side-drop",
                    "bridge"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "What visibly did the work of the throw, as a spectator reads it. Null on katame-waza."
            },
            "groundPosition": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "behind",
                    "on-top",
                    "beside-chest",
                    "beside-head",
                    "over-head",
                    "underneath",
                    "legs-wrapped"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the attacker is relative to the person controlled. Set on osaekomi-waza and shime-waza, null everywhere else."
            },
            "strangleUses": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "collar",
                    "bare-arm",
                    "legs"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the strangle is applied with. Set on shime-waza, null everywhere else."
            },
            "lock": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "arm-straight-legs-across",
                    "arm-bent",
                    "arm-straight-body",
                    "leg-entangled"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "How the lock looks: which limb is trapped and in what shape. Set on kansetsu-waza, null everywhere else."
            },
            "lockPress": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "knee",
                    "leg",
                    "armpit",
                    "stomach",
                    "hands"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "What presses on the straightened arm, as a spectator sees it. Set when lock is arm-straight-body, null everywhere else."
            },
            "cue": {
              "$ref": "#/definitions/localisedText"
            },
            "confusableWith": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Techniques a spectator cannot tell this one from at full speed. Symmetric; empty when there are none."
            }
          },
          "required": [
            "counter",
            "fall",
            "mechanism",
            "groundPosition",
            "strangleUses",
            "lock",
            "lockPress",
            "cue",
            "confusableWith"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Observable facts for the technique resolver: which way somebody fell, what did the work, where the attacker was, and the one-line cue that names it. Null where nobody has tagged the technique yet."
    }
  },
  "required": [
    "nameRomaji",
    "nameJa",
    "nameKana",
    "aliases",
    "otherNames",
    "gloss",
    "category",
    "subCategory",
    "wazaType",
    "gokyoSet",
    "kodokanNumber",
    "kodokanAbbr",
    "kodokan",
    "banned",
    "bannedNote",
    "videos",
    "ijfAnimation",
    "links",
    "image",
    "about",
    "keyPoints",
    "described",
    "receiving",
    "viNotes",
    "resolver"
  ],
  "additionalProperties": false,
  "definitions": {
    "localisedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by BCP 47 language code; \"en\" required, other languages optional."
    },
    "video": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube",
            "vimeo"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "allOf": [
            {
              "$ref": "#/definitions/localisedText"
            }
          ]
        },
        "duration": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "default": false,
          "type": "boolean"
        },
        "lang": {
          "type": "string"
        },
        "captions": {
          "type": "boolean"
        },
        "spokenInstruction": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "platform",
        "id",
        "title"
      ]
    },
    "linkRef": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "url",
        "source"
      ]
    },
    "imageRef": {
      "type": "object",
      "properties": {
        "alt": {
          "$ref": "#/definitions/localisedText"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "own",
            "licensed",
            "third-party",
            "unknown"
          ]
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "alt",
        "provenance"
      ]
    },
    "localisedKeyPoints": {
      "type": "object",
      "properties": {
        "en": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "minItems": 3,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Exactly three key points per language; \"en\" required."
    },
    "localisedSteps": {
      "type": "object",
      "properties": {
        "en": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Ordered movement steps per language (at least two); \"en\" required."
    }
  },
  "title": "technique",
  "description": "One judo technique. The entry id/slug is the lowercase hyphenated romaji name. Every field is present in every file, in the order listed here: a field nobody has written yet is null (or an empty array), never absent, so that a gap in the reference is visible to a reader and countable by the validator."
}
