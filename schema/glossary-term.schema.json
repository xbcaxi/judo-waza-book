{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "term": {
      "type": "string",
      "minLength": 1
    },
    "kanji": {
      "type": "string",
      "minLength": 1
    },
    "kana": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "meaning": {
      "$ref": "#/definitions/localisedText"
    },
    "category": {
      "type": "string",
      "enum": [
        "command",
        "scoring",
        "etiquette",
        "people",
        "kit-and-place",
        "training",
        "grading",
        "classification",
        "name-part"
      ]
    },
    "techniques": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guides": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "term",
    "meaning",
    "category"
  ],
  "definitions": {
    "localisedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by BCP 47 language code; \"en\" required, other languages optional."
    }
  },
  "title": "glossary-term",
  "description": "One word a judoka hears on the mat and is asked to explain at grading, or one of the pieces technique names are built from. The term id is the filename."
}
