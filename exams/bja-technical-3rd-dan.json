{
  "title": {
    "en": "3rd Dan Technical Examination"
  },
  "organisation": "British Judo Association",
  "country": "GB",
  "summary": {
    "en": "The BJA technical route to 3rd Dan: twenty set techniques in their traditional form, prior learning chosen by the examiner, and performance skills in combination, counter and transition. Every section is passed at 80 per cent."
  },
  "source": {
    "title": "3rd Dan Grade TECHNICAL Mark Sheet",
    "date": "October 2025",
    "note": {
      "en": "Transcribed from the official BJA mark sheet. The marking scale comes from the Guide for Dan Grade Evaluation of Competitive Skills and Technical Exam, issued 1 July 2025, and the framing from the Technical Dan Grade Scheme Assessment Guide. The forms are the authority; where this page and a current BJA form disagree, the form wins."
    }
  },
  "marking": {
    "en": "Every demonstration is scored from 0 to 10 in whole marks against the BJA's published criteria, where 10 is a close-to-perfect execution, 7 is a competently executed technique meeting all basic expectations, 6 lacks effective kuzushi, tsukuri, kake or core elements, and 0 is an omitted or unrelated technique. Sections 1 and 2 are demonstrated in the Kodokan canonical form with traditional grips; variations and unorthodox grips are permitted in Sections 3 to 5, discussed with the examiner first. The pass mark is 80 per cent of every section and of the whole, which is the difference from the competitive route rather than the content."
  },
  "levels": [
    {
      "label": {
        "en": "3rd Dan"
      },
      "passMark": 448,
      "maxMarks": 560,
      "requirements": [
        {
          "section": "fundamental-skills",
          "requirement": {
            "en": "All twenty techniques set for the grade. Pass mark 160."
          },
          "marks": 200
        },
        {
          "section": "prior-learning",
          "requirement": {
            "en": "Five techniques from each grade below, chosen by the examiner: 10 in all. Pass mark 80."
          },
          "marks": 100
        },
        {
          "section": "nage-waza-performance",
          "requirement": {
            "en": "Five nage-waza, candidate's choice, each shown as a renzoku-waza, a renraku-waza and a kaeshi-waza. Pass mark 120."
          },
          "marks": 150
        },
        {
          "section": "katame-waza-performance",
          "requirement": {
            "en": "Five katame-waza, candidate's choice, each shown as a combination, an escape or a complex entry. Pass mark 40."
          },
          "marks": 50
        },
        {
          "section": "transitions",
          "requirement": {
            "en": "Three nage-waza into osaekomi-waza and three into kansetsu-waza or shime-waza. Pass mark 48."
          },
          "marks": 60
        }
      ]
    }
  ],
