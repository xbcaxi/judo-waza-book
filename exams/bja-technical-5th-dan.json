      "maxMarks": 780,
      "requirements": [
        {
          "section": "fundamental-skills",
          "requirement": {
            "en": "All twenty techniques set for the grade. Pass mark 160."
          },
          "marks": 200
        },
        {
          "section": "prior-learning",
          "requirement": {
            "en": "Five techniques from each grade below, chosen by the examiner: 20 in all. Pass mark 160."
          },
          "marks": 200
        },
        {
          "section": "nage-waza-performance",
          "requirement": {
            "en": "Seven nage-waza, candidate's choice, each shown as a renzoku-waza, a renraku-waza and a kaeshi-waza. Pass mark 168."
          },
          "marks": 210
        },
        {
          "section": "katame-waza-performance",
          "requirement": {
            "en": "Seven katame-waza, candidate's choice, each shown as a combination, an escape or a complex entry. Pass mark 56."
          },
          "marks": 70
        },
        {
          "section": "transitions",
          "requirement": {
            "en": "Five nage-waza into osaekomi-waza and five into kansetsu-waza or shime-waza. Pass mark 80."
          },
          "marks": 100
        }
      ]
    }
  ],
